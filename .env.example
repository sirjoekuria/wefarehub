# Local preview opens directly without login. Set DEMO_MODE=false for a real deployment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@stanriders.co.ke
DEMO_ADMIN_PASSWORD=replace-with-a-strong-demo-password

# Supabase: configure these to use Supabase Auth and the real database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Edge Function secrets: set with `supabase secrets set`, never NEXT_PUBLIC.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=234567
# Daraja OAuth passkey (not the initiator security credential). C2B does not use it.
MPESA_PASSKEY=
C2B_RESPONSE_TYPE=Completed
# Optional explicit registration URLs; defaults to SUPABASE_URL/functions/v1/mpesa-*.
CALLBACK_BASE_URL=

# Only for scripts/register-c2b.ts. Prefer supplying the password in your shell.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CONFIRM_PRODUCTION=no

# Rocpay Integration Secret (shared secret key for offline payment sync)
ROCPAY_WEBHOOK_SECRET=your-secure-rocpay-webhook-secret
